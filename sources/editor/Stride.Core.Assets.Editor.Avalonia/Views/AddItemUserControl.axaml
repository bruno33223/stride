<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Stride.Core.Assets.Editor.Avalonia.Views"
             xmlns:viewModels="using:Stride.Core.Assets.Editor.Components.TemplateDescriptions.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="Stride.Core.Assets.Editor.Avalonia.Views.AddItemUserControl"
             x:Name="AddItemRoot">

  <Grid ColumnDefinitions="Auto,Auto,*">
    <!-- Painel Esquerdo: Busca e Grupos -->
    <DockPanel Grid.Column="0" Margin="4" x:Name="LeftPanel">
      <DockPanel Margin="4" DockPanel.Dock="Top">
        <Button VerticalAlignment="Center" Margin="8,0,0,0"
                DockPanel.Dock="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                IsVisible="{Binding SelectFilesToCreateItemCommand, ElementName=AddItemRoot, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding SelectFilesToCreateItemCommand, ElementName=AddItemRoot}"
                ToolTip.Tip="Import directly from files" Width="28" Height="28" Padding="2">
          <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <TextBox x:Name="SearchBox"
                 VerticalAlignment="Center"
                 PlaceholderText="Search"
                 Text="{Binding TemplateCollection.SearchToken, ElementName=AddItemRoot, Mode=TwoWay}"/>
      </DockPanel>

      <ListBox x:Name="GroupList"
               ItemsSource="{Binding TemplateCollection.RootGroup.SubGroups, ElementName=AddItemRoot}"
               SelectedItem="{Binding TemplateCollection.SelectedGroup, ElementName=AddItemRoot, Mode=TwoWay}"
               MinWidth="160" VerticalAlignment="Top">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:TemplateDescriptionGroupViewModel">
            <TextBlock Text="{Binding Name}" Margin="6,3"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" VerticalAlignment="Stretch" Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

    <!-- Painel Direito: Lista de Templates -->
    <ListBox x:Name="TemplateListBox"
             Grid.Column="2"
             Margin="4"
             Width="500"
             ItemsSource="{Binding TemplateCollection.Templates, ElementName=AddItemRoot}"
             SelectedItem="{Binding TemplateCollection.SelectedTemplate, ElementName=AddItemRoot, Mode=TwoWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             DoubleTapped="TemplateListBox_OnDoubleTapped"
             KeyDown="TemplateListBox_OnKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="viewModels:ITemplateDescriptionViewModel">
          <DockPanel Height="56" Margin="4">
            <Image Source="{Binding Icon}" DockPanel.Dock="Left" Width="48" Height="48" Margin="2"/>
            <DockPanel Margin="12,0" VerticalAlignment="Center">
              <TextBlock DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Text="{Binding Name}"/>
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
            </DockPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
