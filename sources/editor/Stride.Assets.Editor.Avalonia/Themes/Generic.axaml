        <GeometryDrawing Brush="#FFEFEFF0" Geometry="F1M10,5L8,5 8,7 10,7z M12,4L12,9 10.5,8 8.5,9 6,5.874 4,8.084 4,4z M12,12L4,12 4,10.084 6,7.874 8.5,11 10.5,9.451 12,11z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- ControlTheme para AnimationPreviewView -->
  <ControlTheme x:Key="{x:Type views:AnimationPreviewView}" TargetType="views:AnimationPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:AnimationPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}" Name="ToolBar">
            <StackPanel Margin="4" Orientation="Horizontal" Spacing="4">
              <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <Button Command="{Binding PlayCommand}" Background="Transparent" ToolTip.Tip="Play the animation">
                <Image Source="{StaticResource ImagePlay}" Width="16" Height="16"/>
              </Button>
              <Button Command="{Binding PauseCommand}" Background="Transparent" ToolTip.Tip="Pause the animation">
                <Image Source="{StaticResource ImagePause}" Width="16" Height="16"/>
              </Button>

              <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <TextBlock VerticalAlignment="Center" Margin="4,0">
                <Run Text="{Binding CurrentTime, StringFormat='{}{0:0.000}', Mode=OneWay}"/>
                /
                <Run Text="{Binding Duration, StringFormat='{}{0:0.000}', Mode=OneWay}"/>
              </TextBlock>

              <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <TextBlock Text="Time scale:" VerticalAlignment="Center" Margin="4,0"/>
              <NumericUpDown Value="{Binding TimeScale}" Increment="0.1" Width="80" Minimum="0.0" FormatString="0.000" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsValid}">
            <StackPanel Margin="10,5">
              <Slider Minimum="0" Maximum="{Binding Duration}"
                      Name="Slider" Value="{Binding CurrentTime}" Height="20"/>
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para MaterialPreviewView -->
  <ControlTheme x:Key="{x:Type views:MaterialPreviewView}" TargetType="views:MaterialPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:MaterialPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}">
            <ListBox Margin="0" SelectedItem="{Binding SelectedPrimitive}" Padding="2" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding PrimitiveTypes}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Width="20" Height="20" Margin="0,0,1,0">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para ModelPreviewView -->
  <ControlTheme x:Key="{x:Type views:ModelPreviewView}" TargetType="views:ModelPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:ModelPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}">
            <StackPanel Orientation="Horizontal" Margin="6" Spacing="4">
              <Button Command="{Binding ResetModelCommand}" Background="Transparent" ToolTip.Tip="Reset the camera">
                <Image Source="{StaticResource ImageResetCamera}" Width="16" Height="16"/>
              </Button>
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para SkyboxPreviewView -->
  <ControlTheme x:Key="{x:Type views:SkyboxPreviewView}" TargetType="views:SkyboxPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:SkyboxPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Vertical" Margin="6" Spacing="4" HorizontalAlignment="Stretch">
              <Button Command="{Binding ResetModelCommand}" Background="Transparent" ToolTip.Tip="Reset the camera" HorizontalAlignment="Left">
                <Image Source="{StaticResource ImageResetCamera}" Width="16" Height="16"/>
              </Button>
              <Grid HorizontalAlignment="Stretch" ColumnDefinitions="70, *">
                <TextBlock Grid.Column="0" Text="Metalness" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Value="{Binding Metalness}" Height="20" Minimum="0" Maximum="1" HorizontalAlignment="Stretch"/>
              </Grid>
              <Grid HorizontalAlignment="Stretch" ColumnDefinitions="70, *">
                <TextBlock Grid.Column="0" Text="Glossiness" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Value="{Binding Glossiness}" Height="20" Minimum="0" Maximum="1" HorizontalAlignment="Stretch"/>
              </Grid>
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para EntityPreviewView -->
  <ControlTheme x:Key="{x:Type views:EntityPreviewView}" TargetType="views:EntityPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:EntityPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}">
            <StackPanel Orientation="Horizontal" Margin="6" Spacing="4">
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para ScenePreviewView -->
  <ControlTheme x:Key="{x:Type views:ScenePreviewView}" TargetType="views:ScenePreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:ScenePreviewView">
        <DockPanel Background="{DynamicResource NormalBrush}">
          <TextBlock Text="Scenes can't be previewed. To see the scene, open it in the scene editor."
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para SoundPreviewView -->
  <ControlTheme x:Key="{x:Type views:SoundPreviewView}" TargetType="views:SoundPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:SoundPreviewView">
        <DockPanel Background="{DynamicResource NormalBrush}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" IsVisible="{Binding IsAudioValid}" Spacing="4" Margin="4">
            <Button Command="{Binding PlayCommand}" Background="Transparent" ToolTip.Tip="Play the sound">
              <Image Source="{StaticResource ImagePlay}" Width="16" Height="16"/>
            </Button>
            <Button Command="{Binding PauseCommand}" Background="Transparent" ToolTip.Tip="Pause the sound">
              <Image Source="{StaticResource ImagePause}" Width="16" Height="16"/>
            </Button>
            <Slider Height="16" Margin="5" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" Width="60"/>
          </StackPanel>
          <Border VerticalAlignment="Center">
            <StackPanel Spacing="4">
              <Slider Height="20" Margin="15,5" Minimum="0" Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}" Value="{Binding CurrentValue}" IsVisible="{Binding IsAudioValid}"/>
              <TextBlock HorizontalAlignment="Center" IsVisible="{Binding IsAudioValid}">
                <Run Text="{Binding CurrentTime, StringFormat='{}{0:mm\\:ss\\:fff}', Mode=OneWay}"/>/<Run Text="{Binding Duration, StringFormat='{}{0:mm\\:ss\\:fff}', Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Text="Building preview sound asset..." HorizontalAlignment="Center" IsVisible="{Binding !IsAudioValid}"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para SpriteSheetPreviewView -->
  <ControlTheme x:Key="{x:Type views:SpriteSheetPreviewView}" TargetType="views:SpriteSheetPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:SpriteSheetPreviewView">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}">
            <TextBlock DockPanel.Dock="Right" Margin="5" VerticalAlignment="Center" Text="{Binding SpriteScale, StringFormat='{}{0:P}'}"/>
            <StackPanel Orientation="Horizontal" Margin="4" Spacing="2">
              <Button Command="{Binding PreviewZoomOutCommand}" Background="Transparent" Margin="2">
                <Image Source="{StaticResource ImageZoomOut}" Width="16" Height="16" />
              </Button>
              <Button Command="{Binding PreviewZoomInCommand}" Background="Transparent" Margin="2">
                <Image Source="{StaticResource ImageZoomIn}" Width="16" Height="16" />
              </Button>
              <Button Command="{Binding PreviewScaleToRealSizeCommand}" Background="Transparent" Margin="2">
                <Image Source="{StaticResource ImageScaleOnRealSize}" Width="16" Height="16" />
              </Button>
              <Button Command="{Binding PreviewFitOnScreenCommand}" Background="Transparent" Margin="2">
                <Image Source="{StaticResource ImageFitOnScreen}" Width="16" Height="16" />
              </Button>
              <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <ComboBox Width="120" SelectedItem="{Binding DisplayMode}" ItemsSource="{Binding DisplayModes, FallbackValue={x:Null}}"/>
              <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <Button Command="{Binding PreviewPreviousFrameCommand}" Background="Transparent" ToolTip.Tip="Previous sprite" Content="&lt;" Padding="4,0"/>
              <TextBlock VerticalAlignment="Center" Margin="4">
                <Run Text="Sprite:"/>
                <Run Text="{Binding PreviewCurrentFrame, Mode=OneWay}"/>/<Run Text="{Binding PreviewFrameCount, Mode=OneWay}"/>
              </TextBlock>
              <Button Command="{Binding PreviewNextFrameCommand}" Background="Transparent" ToolTip.Tip="Next sprite" Content="&gt;" Padding="4,0"/>
            </StackPanel>
          </DockPanel>
          <Border DockPanel.Dock="Bottom">
            <Slider Height="20" Margin="5" Minimum="1" Maximum="{Binding PreviewFrameCount, Mode=OneWay}" Value="{Binding PreviewCurrentFrame}"/>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para SpriteFontPreviewView -->
  <ControlTheme x:Key="{x:Type views:SpriteFontPreviewView}" TargetType="views:SpriteFontPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:SpriteFontPreviewView">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrush}">
            <Grid Margin="4" ColumnDefinitions="*, Auto">
              <TextBox Grid.Column="0" Text="{Binding PreviewString}" MaxHeight="32" Watermark="Preview text" AcceptsReturn="True"/>
              <Button Grid.Column="1" Command="{Binding ClearTextCommand}" Background="Transparent" Margin="4,0,0,0">
                <Image Source="{StaticResource ImageClear}" Width="16" Height="16" />
              </Button>
            </Grid>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para TexturePreviewView -->
  <ControlTheme x:Key="{x:Type views:TexturePreviewView}" TargetType="views:TexturePreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:TexturePreviewView">
        <DockPanel>
          <Grid Background="{DynamicResource NormalBrush}" DockPanel.Dock="Top" RowDefinitions="Auto">
            <DockPanel Grid.Row="0">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="2" Margin="4">
                <Button Command="{Binding PreviewZoomOutCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageZoomOut}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewZoomInCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageZoomIn}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewScaleToRealSizeCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageScaleOnRealSize}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewFitOnScreenCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageFitOnScreen}" Width="16" Height="16" />
                </Button>
                <Border Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
                <ComboBox ItemsSource="{Binding PreviewAvailableMipMaps}" MinWidth="100" SelectedItem="{Binding PreviewSelectedMipMap}" Margin="2"/>
              </StackPanel>
            </DockPanel>
          </Grid>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource NormalBrush}" Padding="6,2" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto, 2*">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding SpriteScale, StringFormat='{}{0:P}'}"/>
              <Border Grid.Column="1" Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding PreviewTextureWidth, StringFormat='W: {0}'}"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding PreviewTextureHeight, StringFormat='H: {0}'}"/>
              </StackPanel>
            </Grid>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ControlTheme para HeightmapPreviewView -->
  <ControlTheme x:Key="{x:Type views:HeightmapPreviewView}" TargetType="views:HeightmapPreviewView" BasedOn="{StaticResource {x:Type editorViews:StridePreviewView}}">
    <Setter Property="Template">
      <ControlTemplate TargetType="views:HeightmapPreviewView">
        <DockPanel>
          <Grid Background="{DynamicResource NormalBrush}" DockPanel.Dock="Top" RowDefinitions="Auto">
            <DockPanel Grid.Row="0">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="2" Margin="4">
                <Button Command="{Binding PreviewZoomOutCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageZoomOut}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewZoomInCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageZoomIn}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewScaleToRealSizeCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageScaleOnRealSize}" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding PreviewFitOnScreenCommand}" Background="Transparent" Margin="2">
                  <Image Source="{StaticResource ImageFitOnScreen}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </DockPanel>
          </Grid>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource NormalBrush}" Padding="6,2" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto, 2*">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding SpriteScale, StringFormat='{}{0:P}'}"/>
              <Border Grid.Column="1" Width="1" Margin="6,2,6,2" Background="{DynamicResource NormalBorderBrush}"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding PreviewHeightmapWidth, StringFormat='W: {0}'}"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding PreviewHeightmapLength, StringFormat='L: {0}'}"/>
              </StackPanel>
            </Grid>
          </Border>
          <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
