      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="ImageFitOnScreen">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
        <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M9,-0.000199999999999534L9,1.9998 2,1.9998 2,8.9998 0,8.9998 0,15.9998 7,15.9998 7,13.9998 14,13.9998 14,6.9998 16,6.9998 16,-0.000199999999999534z" />
