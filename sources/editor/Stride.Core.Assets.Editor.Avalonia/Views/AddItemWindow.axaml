<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Stride.Core.Assets.Editor.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420"
        x:Class="Stride.Core.Assets.Editor.Avalonia.Views.AddItemWindow"
        x:Name="RootAddItemWindow"
        Title="Add asset..."
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel>
    <views:AddItemUserControl x:Name="AddAssetControl"
                              Margin="10"
                              TemplateCollection="{Binding #RootAddItemWindow.TemplateDescriptions}"
                              AddItemCommand="{Binding #RootAddItemWindow.AddItemCommand}"/>
  </DockPanel>
</Window>
