<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="using:Stride.Editor.Avalonia.Preview.Views">

  <ControlTheme x:Key="{x:Type view:StridePreviewView}" TargetType="view:StridePreviewView">
    <Setter Property="Template">
      <ControlTemplate TargetType="view:StridePreviewView">
        <ContentPresenter Name="PART_StrideView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
