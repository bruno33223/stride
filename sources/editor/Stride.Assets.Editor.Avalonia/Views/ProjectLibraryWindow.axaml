<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Stride.Assets.Editor.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="280"
        x:Class="Stride.Assets.Editor.Avalonia.Views.ProjectLibraryWindow"
        x:DataType="views:ProjectLibraryWindow"
        Title="New code library"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">
  <StackPanel Margin="20">
    <TextBlock Text="Library name:" Margin="0,0,0,5" FontWeight="Medium"/>
    <TextBox x:Name="LibBox" Text="{Binding LibraryName}" Margin="0,0,0,15"/>

    <TextBlock Text="Namespace:" Margin="0,0,0,5" FontWeight="Medium"/>
    <TextBox x:Name="NamespaceBox" Text="{Binding Namespace}" Margin="0,0,0,10"/>

    <TextBlock x:Name="WarningLabel" Margin="0,0,0,15" Text="Name already exists" IsVisible="{Binding HasError}" Foreground="Tomato"/>

    <UniformGrid Rows="1" Margin="0,10,0,0">
      <Button Content="OK" Margin="0,0,10,0" Padding="8" HorizontalContentAlignment="Center" Click="ButtonOk" IsDefault="True"/>
      <Button Content="Cancel" Margin="10,0,0,0" Padding="8" HorizontalContentAlignment="Center" Click="ButtonCancel" IsCancel="True"/>
    </UniformGrid>
  </StackPanel>
</Window>
