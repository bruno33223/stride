<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sd="http://schemas.stride3d.net/xaml/presentation"
        xmlns:views="using:Stride.GameStudio.Avalonia.Views"
        mc:Ignorable="d"
        x:Class="Stride.GameStudio.Avalonia.Views.NotificationWindow"
        x:DataType="views:NotificationWindow"
        Title="Notification"
        Width="350"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border Margin="10"
          Background="#25252A"
          BorderBrush="#3E3E46"
          BorderThickness="1"
          CornerRadius="8"
          BoxShadow="0 4 16 0 #70000000"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
      <!-- Header: Title and Close button -->
      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right"
                Width="24" Height="24"
                Padding="0"
                CornerRadius="4"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnClick_Close"
                ToolTip.Tip="{sd:LocalizeString Close, Context=ToolTip}">
          <TextBlock Text="✕" FontSize="11" Foreground="#A0A0A0" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="9" Background="#007ACC" VerticalAlignment="Center">
            <TextBlock Text="ℹ" FontSize="11" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
          </Border>
          <TextBlock Text="{Binding Caption}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="#F0F0F0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>

      <!-- Message body -->
      <TextBlock Grid.Row="1"
                 Text="{Binding Message}"
                 TextWrapping="Wrap"
                 Foreground="#C8C8CE"
                 FontSize="12"
                 LineHeight="18"
                 Margin="0,0,0,10" />

      <!-- Footer: Optional Action button -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  IsVisible="{Binding HasActionCommand}">
        <Button Content="{Binding ActionButtonText}"
                Padding="12,5"
                CornerRadius="4"
                Background="#007ACC"
                Foreground="White"
                FontSize="12"
                FontWeight="Medium"
                Click="OnClick_Action" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
