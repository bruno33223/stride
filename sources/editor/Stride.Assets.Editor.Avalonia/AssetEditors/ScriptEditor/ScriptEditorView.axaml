<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Stride.Assets.Editor.AssetEditors.ScriptEditor;assembly=Stride.Assets.Editor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Stride.Assets.Editor.Avalonia.AssetEditors.ScriptEditor.ScriptEditorView"
             x:DataType="vm:ScriptEditorViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto, *">
    <!-- Header com nome do script e status -->
    <Border Grid.Row="0" Background="#252528" BorderBrush="#38383D" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Script:" Foreground="#888888" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Asset.Name}" FontWeight="Bold" Foreground="#4EC9B0" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Área de edição de código -->
    <Grid Grid.Row="1">
      <TextBox x:Name="CodeEditorTextBox"
               FontFamily="Consolas, Menlo, Monaco, DejaVu Sans Mono, monospace"
               FontSize="13"
               AcceptsReturn="True"
               AcceptsTab="True"
               BorderThickness="0"
               Background="#1E1E1E"
               Foreground="#D4D4D4"/>
    </Grid>
  </Grid>
</UserControl>
