<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Stride.Assets.Editor.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="400"
        x:Class="Stride.Assets.Editor.Avalonia.Views.DotNetNewTemplateParametersWindow"
        x:DataType="views:DotNetNewTemplateParametersWindow"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <Border Grid.Row="0" Background="{DynamicResource ThemeAccentBrush4}" CornerRadius="4" Padding="15,10" Margin="0,0,0,10">
      <TextBlock Text="{Binding TemplateName}" FontSize="16" FontWeight="SemiBold"/>
    </Border>

    <TextBlock x:Name="DescriptionTextBlock" Grid.Row="1" Text="{Binding TemplateDescription}" Margin="0,0,0,12" TextWrapping="Wrap"/>

    <ScrollViewer Grid.Row="2" MaxHeight="450" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ParametersPanel" Margin="0,0,0,10" Spacing="6"/>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
      <Button x:Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OnOk"/>
      <Button x:Name="CancelButton" Content="Cancel" Width="80" HorizontalContentAlignment="Center" Click="OnCancel"/>
    </StackPanel>
  </Grid>
</Window>
