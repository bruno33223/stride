<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />

  <PropertyGroup>
    <TargetFramework>$(StrideXplatEditorTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--auto-module-initializer --serialization</StrideAssemblyProcessorOptions>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="AssetEditors\Gizmos\GizmoResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GizmoResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="AssetEditors\Gizmos\GizmoResources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>GizmoResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stride.Assets.Presentation\Stride.Assets.Presentation.csproj" />
    <ProjectReference Include="..\Stride.Core.Assets.Presentation\Stride.Core.Assets.Presentation.csproj" />
    <ProjectReference Include="..\Stride.Core.Assets.Editor\Stride.Core.Assets.Editor.csproj" />
    <ProjectReference Include="..\..\assets\Stride.Core.Assets\Stride.Core.Assets.csproj" />
    <ProjectReference Include="..\Stride.Editor\Stride.Editor.csproj" />
    <ProjectReference Include="..\..\core\Stride.Core.Design\Stride.Core.Design.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Voxels\Stride.Voxels.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Particles\Stride.Particles.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\..\tools\Stride.Graphics.RenderDocPlugin\Stride.Graphics.RenderDocPlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="RoslynPad.Roslyn" />
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\Stride.TemplateGenerator\SdtplMetadata.cs">
      <Link>Templates\SdtplMetadata.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\VideoFromFileTemplateGenerator.cs">
      <Link>Templates\VideoFromFileTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\HullAssetFactoryTemplateGenerator.cs">
      <Link>Templates\HullAssetFactoryTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\HeightmapFactoryTemplateGenerator.cs">
      <Link>Templates\HeightmapFactoryTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\GraphicsCompositorTemplateGenerator.cs">
      <Link>Templates\GraphicsCompositorTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\ProceduralModelFactoryTemplateGenerator.cs">
      <Link>Templates\ProceduralModelFactoryTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\ColliderShapeStaticMeshFactoryTemplateGenerator.cs">
      <Link>Templates\ColliderShapeStaticMeshFactoryTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\ColliderShapeHullFactoryTemplateGenerator.cs">
      <Link>Templates\ColliderShapeHullFactoryTemplateGenerator.cs</Link>
    </Compile>
    <Compile Include="..\Stride.Assets.Presentation\Templates\SkyboxFactoryTemplateGenerator.cs">
      <Link>Templates\SkyboxFactoryTemplateGenerator.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameEntityCameraService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameEntitySelectionService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameEntityTransformService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameGraphicsCompositorService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameMaterialHighlightService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameModelSelectionService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameNavigationMeshService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Game\EditorGameRenderModeService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Services\IEditorGameEntityCameraViewModelService.cs" />
    <Compile Remove="AssetEditors\EntityHierarchyEditor\Services\IEditorGameMaterialHighlightViewModelService.cs" />
    <Compile Remove="AssetEditors\GameEditor\Game\EditorGameAssetHighlighterService.cs" />
    <Compile Remove="Templates/Core/**" />
    <Compile Remove="Templates/Assets/**" />
    <None Include="Templates/Core/**" />
    <None Include="Templates/Assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Remove="Thumbnails/**" />
    <Compile Include="Thumbnails/GameStudioThumbnailService.cs" />
    <Compile Include="Thumbnails/ThumbnailAssetBuildUnit.cs" />
    <Compile Include="Thumbnails/ThumbnailBuildHelper.cs" />
    <Compile Include="Thumbnails/ThumbnailBuildStep.cs" />
    <Compile Include="Thumbnails/ThumbnailBuiltEventArgs.cs" />
    <Compile Include="Thumbnails/ThumbnailGenerator.cs" />
  </ItemGroup>

  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
