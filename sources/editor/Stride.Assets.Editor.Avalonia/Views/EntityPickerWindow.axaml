<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Stride.Assets.Editor.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
        x:Class="Stride.Assets.Editor.Avalonia.Views.EntityPickerWindow"
        x:DataType="views:EntityPickerWindow"
        Title="Select an entity"
        Width="500" Height="700"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <!-- Header / Description -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Select an entity:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
      <TextBlock Text="Choose an entity or component from the scene hierarchy below." Foreground="#888888" FontSize="12"/>
    </StackPanel>

    <!-- Main Content Grid -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
      <!-- Entity Hierarchy Tree -->
      <Border Grid.Column="0" Background="#1E1E22" BorderBrush="#323238" BorderThickness="1" CornerRadius="4" Padding="4">
        <TreeView ItemsSource="{Binding SceneContent}"
                  SelectedItem="{Binding SelectedEntity, Mode=TwoWay}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Content}" x:DataType="views:EntityPickerWindow+EntityHierarchyItemViewModelWrapper">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <!-- Splitter / Separator -->
      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

      <!-- Components List (visible when ComponentType is set) -->
      <Border Grid.Column="2" Background="#1E1E22" BorderBrush="#323238" BorderThickness="1" CornerRadius="4" Padding="4"
              IsVisible="{Binding ComponentType, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ListBox ItemsSource="{Binding SelectedWrapper.Components}"
                 SelectedItem="{Binding SelectedWrapper.SelectedComponent, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                <TextBlock Text="⚙️" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Item2}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Item1, StringFormat='(Index: {0})'}" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- Bottom Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Content="OK"
              Width="80"
              HorizontalContentAlignment="Center"
              IsEnabled="{Binding SelectionValid}"
              Click="OnOkClick"/>
      <Button Content="Cancel"
              Width="80"
              HorizontalContentAlignment="Center"
              Click="OnCancelClick"/>
    </StackPanel>
  </Grid>
</Window>
