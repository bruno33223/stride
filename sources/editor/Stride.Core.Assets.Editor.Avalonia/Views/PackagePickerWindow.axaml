<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Stride.Core.Assets.Editor.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="Stride.Core.Assets.Editor.Avalonia.Views.PackagePickerWindow"
        x:DataType="views:PackagePickerWindow"
        Title="Select a package" Height="640" Width="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <ListBox x:Name="PackageListBox" Grid.Row="0" Margin="4"
             ItemsSource="{Binding Packages}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Content="OK"
              Width="80"
              HorizontalContentAlignment="Center"
              IsEnabled="{Binding #PackageListBox.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
              Click="OnOkClick"/>
      <Button Content="Cancel"
              Width="80"
              HorizontalContentAlignment="Center"
              Click="OnCancelClick"/>
    </StackPanel>
  </Grid>
</Window>
